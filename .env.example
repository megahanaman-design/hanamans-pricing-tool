# eBay Developer Portal application credentials (required only for eBay connection).
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# This is the RuName from eBay Developer Portal, not the callback URL.
EBAY_RUNAME=

# 32-80 chars, alphanumeric / underscore / hyphen only. Use the same value in
# eBay Developer Portal Marketplace Account Deletion notification settings.
EBAY_DELETION_VERIFY_TOKEN=

# Use a sufficiently long random value outside local-only development.
DJANGO_SECRET_KEY=
